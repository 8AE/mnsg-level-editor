{
  "name": "mnsg-level-editor",
  "version": "0.3.5",
  "private": true,
  "description": "Local MNSG room and actor editor for macOS and Windows",
  "author": "MNSG Level Editor contributors",
  "license": "MIT",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "next dev --webpack --hostname 127.0.0.1 --port 3000",
    "build": "next build --webpack && npm run build:electron",
    "build:electron": "node scripts/build-electron.mjs",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:desktop": "node scripts/smoke-desktop.mjs",
    "test:authoring": "node scripts/smoke-authoring.mjs",
    "test:package": "node scripts/smoke-package.mjs",
    "test:workspace:recovery": "node scripts/smoke-workspace-recovery.mjs",
    "release:manifest": "node scripts/release-manifest.mjs",
    "managed:build": "node scripts/build-managed-tools.mjs",
    "managed:smoke": "node scripts/smoke-managed-tools.mjs",
    "package": "npm run managed:smoke && npm run build && electron-builder --publish never",
    "package:mac": "npm run managed:smoke && npm run build && electron-builder --mac --publish never",
    "package:win": "npm run managed:smoke && npm run build && electron-builder --win --publish never",
    "test:editor-ux": "node scripts/smoke-editor-ux.mjs",
    "test:multiselect": "node scripts/smoke-multiselect.mjs",
    "test:scene-tools": "node --import tsx scripts/smoke-scene-tools.mjs"
  },
  "dependencies": {
    "@once-ui-system/core": "2.0.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-icons": "5.7.0",
    "sass": "1.105.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "playwright": "1.63.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "build": {
    "appId": "io.mnsg.level-editor",
    "productName": "MNSG Level Editor",
    "asar": true,
    "beforePack": "scripts/verify-managed-pack.mjs",
    "extraResources": [
      {
        "from": "resources/managed-tools",
        "to": "managed-tools",
        "filter": [
          "**/*"
        ]
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "dist-electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "npmRebuild": false,
    "mac": {
      "identity": "-",
      "minimumSystemVersion": "14.0",
      "signIgnore": [
        "/managed-tools/"
      ],
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
  }
}
