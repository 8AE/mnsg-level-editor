{
  "name": "mnsg-level-editor",
  "version": "0.2.0",
  "private": true,
  "description": "Local MNSG room and actor editor for macOS and Windows",
  "author": "MNSG Level Editor contributors",
  "license": "MIT",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "next dev --webpack --hostname 127.0.0.1 --port 3000",
    "build": "next build --webpack && npm run build:electron",
    "build:electron": "node scripts/build-electron.mjs",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:desktop": "node scripts/smoke-desktop.mjs",
    "test:authoring": "node scripts/smoke-authoring.mjs",
    "test:package": "node scripts/smoke-package.mjs",
    "release:manifest": "node scripts/release-manifest.mjs",
    "package": "npm run build && electron-builder --publish never",
    "package:mac": "npm run build && electron-builder --mac --publish never",
    "package:win": "npm run build && electron-builder --win --publish never"
  },
  "dependencies": {
    "@once-ui-system/core": "2.0.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-icons": "5.7.0",
    "sass": "1.105.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "playwright": "1.63.0",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "build": {
    "appId": "io.mnsg.level-editor",
    "productName": "MNSG Level Editor",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "dist-electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "npmRebuild": false,
    "mac": {
      "identity": "-",
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
  }
}
